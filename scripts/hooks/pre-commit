#!/bin/bash

# Skip in CI environments
if [ -n "$CI" ]; then
    echo "⏭️  Skipping pre-commit hook in CI environment."
    exit 0
fi

# Find swift-format (Xcode toolchain)
SWIFT_FORMAT="/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swift-format"

if [ ! -x "$SWIFT_FORMAT" ]; then
    echo "❌ swift-format not found at $SWIFT_FORMAT"
    echo "   Make sure Xcode is installed."
    exit 1
fi

# Get staged Swift files (Added, Copied, Modified - not deleted)
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$')

if [ -z "$STAGED_SWIFT_FILES" ]; then
    exit 0
fi

echo "🔍 Formatting staged Swift files..."

# Format and re-stage each file
echo "$STAGED_SWIFT_FILES" | while read -r file; do
    if [ -f "$file" ]; then
        "$SWIFT_FORMAT" format --in-place "$file"
        git add "$file"
    fi
done

echo "✅ Swift files formatted."
