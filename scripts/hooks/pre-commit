#!/bin/bash

# Skip in CI environments
if [ -n "$CI" ]; then
    echo "⏭️  Skipping pre-commit hook in CI environment."
    exit 0
fi

# Get staged Swift files (Added, Copied, Modified - not deleted)
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$')

# Track if any check fails
FAILED=0

# =============================================================================
# 1. swift-format (formatting)
# =============================================================================
SWIFT_FORMAT="/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swift-format"

if [ -n "$STAGED_SWIFT_FILES" ]; then
    if [ ! -x "$SWIFT_FORMAT" ]; then
        echo "⚠️  swift-format not found, skipping formatting"
    else
        echo "🔍 Formatting staged Swift files..."
        echo "$STAGED_SWIFT_FILES" | while read -r file; do
            if [ -f "$file" ]; then
                "$SWIFT_FORMAT" format --in-place "$file"
                git add "$file"
            fi
        done
        echo "✅ Formatted"
    fi
fi

# =============================================================================
# 2. SwiftLint (linting)
# =============================================================================
if [ -n "$STAGED_SWIFT_FILES" ]; then
    if command -v swiftlint &> /dev/null; then
        # Auto-fix what we can
        echo "🔍 Linting staged Swift files..."
        echo "$STAGED_SWIFT_FILES" | xargs swiftlint --fix --quiet
        echo "$STAGED_SWIFT_FILES" | while read -r file; do
            if [ -f "$file" ]; then
                git add "$file"
            fi
        done
        # Check for remaining errors
        echo "$STAGED_SWIFT_FILES" | xargs swiftlint lint --quiet --strict
        if [ $? -ne 0 ]; then
            echo "❌ SwiftLint found errors"
            FAILED=1
        else
            echo "✅ Lint passed"
        fi
    else
        echo "⚠️  swiftlint not found, skipping lint (install: brew install swiftlint)"
    fi
fi

# =============================================================================
# 3. typos (spellcheck)
# =============================================================================
if command -v typos &> /dev/null; then
    echo "🔍 Checking spelling..."
    typos
    if [ $? -ne 0 ]; then
        echo "❌ Typos found (run 'typos -w' to fix)"
        FAILED=1
    else
        echo "✅ No typos"
    fi
else
    echo "⚠️  typos not found, skipping spellcheck (install: brew install typos-cli)"
fi

# =============================================================================
# Exit
# =============================================================================
if [ $FAILED -ne 0 ]; then
    echo ""
    echo "❌ Pre-commit checks failed. Fix errors and try again."
    exit 1
fi

echo ""
echo "✅ All pre-commit checks passed"
